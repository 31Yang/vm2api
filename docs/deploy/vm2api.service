[Unit]
Description=vm2api control plane
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/vm2api
EnvironmentFile=/etc/vm2api.env
ExecStart=/usr/bin/node src/server.mjs
Restart=on-failure
RestartSec=2
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
